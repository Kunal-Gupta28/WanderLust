<% layout('/layout/boilerplate')-%>

<div class="container pt-0 mt-0" style="padding-top:0 !important; margin-top:0 !important;">
    <!-- Category Filter Section -->
    <%- include("categories.ejs") %>
    <% if (allListings.length === 0) { %>
        <div class="no-results">
            <i class="fas fa-home"></i>
            <h3 class="mb-3">No Listings Found</h3>
            <p class="text-muted mb-4">No listings available in this category yet.</p>
            <a href="/listing" class="btn btn-primary">
                <i class="fas fa-home me-2"></i>Browse All Listings
            </a>
        </div>
    <% } else { %>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            <% allListings.forEach((listing) => { %>
                <div class="col">
                    <div class="card listing-card h-100">
                        <div class="position-relative">
                            <img src="<%= listing.image.url %>" class="card-img-top listing-image" alt="<%= listing.title %>">
                            <div class="listing-badge">
                                <i class="fas fa-star me-1"></i><%= listing.rating || 'New' %>
                            </div>
                            <div class="listing-category">
                                <i class="fas fa-tag me-1"></i><%= listing.category %>
                            </div>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title mb-3"><%= listing.title %></h5>
                            <p class="listing-location mb-3">
                                <i class="fas fa-map-marker-alt me-2"></i><%= listing.location %>, <%= listing.country %>
                            </p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="listing-price">₹ <%= listing.price %>/night</span>
                                <a href="/listing/<%= listing._id %>" class="btn btn-outline-primary">
                                    <i class="fas fa-info-circle me-2"></i>View Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } %>
</div>

<script>
// Tax info toggle
let taxSwitch = document.getElementById("flexSwitchCheckDefault");
if (taxSwitch) {
    taxSwitch.addEventListener("click", () => {
        let taxinfo = document.getElementsByClassName("tax-info");
        for (let info of taxinfo) {
            if (info.style.display != "inline") {
                info.style.display = "inline";
            } else {
                info.style.display = "none";
            }
        }
    });
}
</script>